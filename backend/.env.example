# Server Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=https://password-reminder.vercel.app

# Database & Security
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=your_32_byte_encryption_key_here!

# SMTP Configuration (Production / Render)
# For Gmail: host=smtp.gmail.com, port=587 (or 465)
# Use a 16-character Google App Password (not standard account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM=RemindPro <your_email@gmail.com>

# Advanced SMTP settings (defaults are already configured in code)
SMTP_FAMILY=4
SMTP_CONNECTION_TIMEOUT=10000
SMTP_GREETING_TIMEOUT=10000
SMTP_SOCKET_TIMEOUT=15000

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
