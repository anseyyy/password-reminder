# Server Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=https://password-reminder.vercel.app

# Database & Security
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=your_32_byte_encryption_key_here!

# ==========================================
# Email Configuration (Production / Render)
# ==========================================
# RECOMMENDED FOR RENDER: Resend HTTP API (Port 443 — never blocked by Render)
# Free 3,000 emails/mo at https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here
# RESEND_FROM=RemindPro <onboarding@resend.dev>  # default test sender or your verified domain

# ALTERNATIVE: Direct SMTP (May be blocked on Render free tier; works locally)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM=RemindPro <your_email@gmail.com>

# Advanced SMTP settings
SMTP_FAMILY=4
SMTP_CONNECTION_TIMEOUT=10000
SMTP_GREETING_TIMEOUT=10000
SMTP_SOCKET_TIMEOUT=15000

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
